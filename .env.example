# --- Connection to VBR (same variables as Veeam's vbr-mcp: one .env can serve both) ---
VBR_BASE_URL=https://vbr01.example.local:9419
VBR_USERNAME=svc-mcp-write
VBR_PASSWORD=
VBR_VERIFY_TLS=True
VBR_API_VERSION=1.3-rev2
VBR_REQUEST_TIMEOUT_SEC=30
# SSL_CERT_FILE=/path/to/vbr-ca.pem          # private CA / self-signed cert, keeps TLS verification on

# --- What this server may do ---
# read | write | destructive. Production recommendation: write (no delete/restore/failover/edits).
VBRW_ACCESS_LEVEL=destructive
# auto | elicit | token | none. auto = ask the user in the MCP client if it supports elicitation, else one-time token.
VBRW_CONFIRMATION_MODE=auto
# Also confirm non-destructive writes (start quick backup, rescans, create object, ...).
VBRW_CONFIRM_WRITES=False
VBRW_CONFIRMATION_TTL_SEC=300
# Never send a state-changing request; return the request that would be sent. Good for demos and first tests.
VBRW_DRY_RUN=False
# JSONL audit log of every write attempt, secrets redacted. Empty = off. Default: audit.jsonl in the project folder.
# VBRW_AUDIT_LOG=/var/log/vbr-write-mcp/audit.jsonl
# Expose only some groups (empty = all): generic, objects, jobs, sessions, backups, restore, replication, agents,
# malware, license, security, infrastructure, system. The describe/read helpers are always on.
VBRW_TOOL_GROUPS=
# Hide individual tools, e.g. api_write,high_availability_cluster
VBRW_DISABLED_TOOLS=
# Extra regexes of paths api_write must refuse, e.g. ^/api/v1/highAvailabilityCluster,^/api/v1/security/
VBRW_BLOCKED_PATHS=

# --- Transport ---
VBRW_TRANSPORT=stdio
# HTTP transport only:
VBRW_HTTP_HOST=127.0.0.1
VBRW_HTTP_PORT=8001
MCP_ENABLED=True
# MCP_TOKENS={"<long-random-token>": "claude-desktop"}
